# ==============================================================================
# Commodity Market Intelligence Platform - Environment Configuration Template
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-commodity-intelligence-dev-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Point-in-Time & Localization
TIME_ZONE=UTC
USE_TZ=True

# Database Configuration
# PostgreSQL is the primary database for the platform.
# Example PostgreSQL URL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commodity_intelligence
# If developing locally without a running PostgreSQL instance, uncomment below for SQLite:
# DATABASE_URL=sqlite:///db.sqlite3

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application Metadata
APP_NAME="Commodity Market Intelligence System"
APP_VERSION="0.1.0-alpha"
